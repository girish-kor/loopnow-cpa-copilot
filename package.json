{
  "name": "loopnow-cpa-copilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/domain-selftest.mjs && (vitest run || echo \"vitest skipped/failed\")",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "eval": "node scripts/eval-selftest.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push",
    "db:seed": "tsx db/seed/seed.ts",
    "test:domain": "node scripts/domain-selftest.mjs",
    "report": "node scripts/domain-selftest.mjs && node scripts/eval-selftest.mjs",
    "eval:full": "tsx evaluation/run.ts",
    "verify": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.22",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "ai": "^4.3.16",
    "clsx": "^2.1.1",
    "@prisma/client": "^6.16.2",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^4.7.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "prisma": "^6.16.2",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.2.4",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "@eslint/eslintrc": "^3.3.0"
  },
  "overrides": {
    "esbuild": "^0.25.1"
  },
  "description": "Production-oriented Canadian GST/HST bookkeeping AI agent (refactored)"
}
