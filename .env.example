# Copy to .env and fill in values:
#   copy .env.example .env          (Windows PowerShell/cmd)
#   cp .env.example .env            (macOS/Linux)

# ── Model ──────────────────────────────────────────────
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=sk-change-me
# Optional for OpenAI-compatible providers (DeepSeek, etc.)
MODEL_BASE_URL=

# ── Postgres ───────────────────────────────────────────
# Matches docker-compose.yml (user/password/db = cpa).
# From your host machine (npm run db:migrate on Windows):
DATABASE_URL=postgresql://cpa:cpa@localhost:5432/cpa
# Inside Docker Compose network use host "db":
# DATABASE_URL=postgresql://cpa:cpa@db:5432/cpa

# ── Redis (optional — distributed rate limiting) ───────
REDIS_URL=

# ── Auth (optional — when set, APIs require x-api-key) ─
API_KEY=

# ── Observability (optional) ───────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=loopnow-cpa-copilot
LANGSMITH_API_KEY=

# ── Runtime ────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
CRA_RULESET_VERSION=2026.09.1
